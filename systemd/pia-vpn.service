[Unit]
Description=Runs PIA over WireGuard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# KEEP RemainAfterExit=yes so port-forward service stays active
RemainAfterExit=yes
WorkingDirectory=/usr/local/bin/manual-connections
TimeoutStartSec=5min
ExecStartPre=/bin/sleep 2
ExecStart=/bin/bash /usr/local/bin/pia-renew-and-connect-no-pf.sh
# Re-apply split tunnel routing on every connect/reconnect (boot, suspend/
# resume, watchdog recovery, manual reconnect). This is a no-op if split
# tunneling was never set up (see pia-split-tunnel.sh reapply). The leading
# "-" means a failure here won't fail the whole VPN service.
ExecStartPost=-/usr/local/bin/pia-split-tunnel.sh reapply
# Turn the kill switch back on as soon as the connect succeeds, if a
# reconnect path (suspend handler, watchdog, applet) disabled it to let the
# connect through. No-op if it was never enabled or the kill switch isn't
# installed; without this, resume relies on the watchdog's next 60s poll.
ExecStartPost=-/usr/local/bin/pia-killswitch.sh restore
Restart=on-failure
RestartSec=10

User=root

[Install]
WantedBy=multi-user.target
